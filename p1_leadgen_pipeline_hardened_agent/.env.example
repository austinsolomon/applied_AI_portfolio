# Copy to .env (git-ignored) and adjust. Matches compose.yaml for local development.
DATABASE_URL=postgresql://leadgen:leadgen_local@127.0.0.1:5433/leadgen

# Needed only for `leadgen ask` (paid). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace: the workspace ID from the Console (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
LEADGEN_MODEL=claude-haiku-5-5
