# Copy to .env (git-ignored) and adjust. Matches compose.yaml for local development.
DATABASE_URL=postgresql://leadgen:leadgen_local@127.0.0.1:5433/leadgen

# Used by `leadgen ask` and the approved pipeline (paid). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace: the workspace ID from the Console (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
LEADGEN_MODEL=claude-haiku-5-5

# The category file (keywords, qualification rate, rubric, host lists); relative to the working directory
CATEGORY_CONFIG_PATH=config/category.yaml
# Needed only for contact enrichment (`leadgen enrich`, paid). Key from https://app.blitz-api.ai
BLITZ_API_KEY=
# BlitzAPI charges a flat monthly rate (the trial has 1,000 free records). Records used are always
# written to the cost ledger; set a per-record price here to amortize the plan into dollar spend.
BLITZ_USD_PER_RECORD=0

# Web search and page fetching (qualification evidence). Optional: without it the free backend
# (httpx + trafilatura, DuckDuckGo HTML results) is used. Key from https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# Dollars per Firecrawl credit for the cost ledger (default: 5,000 credits for $16 a month)
FIRECRAWL_USD_PER_CREDIT=0.0032

# Approved Google Maps and lookalike sourcing
APIFY_API_KEY=
EXA_API_KEY=
LEADGEN_MAX_TURNS=12
